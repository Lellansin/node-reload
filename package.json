{
  "name": "auto-reload",
  "version": "0.2.0",
  "description": "To clear require cache, and auto reload module",
  "main": "index.js",
  "scripts": {
    "test": "node test/run.js",
    "coverage": "c8 --include 'lib/**/*.js' --include 'index.js' --reporter=text --reporter=text-summary --reporter=json-summary --reports-dir coverage --check-coverage --lines 100 --statements 100 --functions 100 --branches 100 npm test"
  },
  "repository": {
    "type": "git",
    "url": "http://github.com/Lellansin/node-reload"
  },
  "keywords": [
    "reload",
    "auto reload",
    "hot reload",
    "reload require",
    "re-require"
  ],
  "author": "Lellansin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Lellansin/node-reload/issues"
  },
  "homepage": "https://github.com/Lellansin/node-reload",
  "engines": {
    "node": ">= 4.0.0"
  },
  "directories": {
    "test": "test"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  }
}
